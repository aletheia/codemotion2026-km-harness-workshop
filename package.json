{
  "name": "codemotion-harness",
  "version": "1.0.0",
  "description": "Event-sourced knowledge-extraction harness for the Casa Protetta workshop (offline, fixture-replayed).",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20.19.0 <21" },
  "scripts": {
    "doctor": "tsx tools/doctor.ts",
    "reset": "tsx tools/reset.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sync": "tsx tools/sync-agent-files.ts",
    "unit": "tsx tools/unit.ts",
    "propose": "tsx tools/propose.ts",
    "replay": "tsx tools/replay.ts",
    "tail": "tsx tools/tail.ts",
    "seg1": "tsx tools/seg1.ts",
    "seg2": "tsx tools/seg2.ts",
    "seg3": "tsx tools/seg3.ts",
    "seg4": "tsx tools/seg4.ts",
    "seg5": "tsx tools/seg5.ts",
    "compare": "tsx tools/compare.ts",
    "golden": "tsx tools/golden.ts",
    "eval": "tsx tools/eval.ts",
    "drift": "tsx tools/drift.ts",
    "log-cat": "tsx tools/log-cat.ts",
    "beliefs": "tsx tools/beliefs.ts",
    "projections-drop": "tsx tools/projections-drop.ts",
    "projections-build": "tsx tools/projections-build.ts",
    "projections-diff": "tsx tools/projections-diff.ts",
    "fixtures": "tsx tools/generate-fixtures.ts",
    "tags": "tsx tools/tags.ts",
    "verify-tags": "tsx tools/verify-tags.ts",
    "scan-names": "tsx tools/scan-names.ts",
    "dry-run": "tsx tools/dry-run.ts"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "zod": "^3.23.8"
  }
}
