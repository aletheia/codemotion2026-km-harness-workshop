{
  "name": "dnk-workshop",
  "version": "0.1.0",
  "private": true,
  "description": "Documents Are Not Knowledge — event-sourced knowledge extraction on art. 2477 c.c. (Codemotion Milan 2026). Offline, fixture-replayed.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "rag:index": "tsx src/tools/rag-index.ts",
    "rag:query": "tsx src/tools/rag-query.ts",
    "rag:delete-v8": "tsx src/tools/rag-delete.ts --version v8",
    "rag:extract-c2": "tsx src/tools/rag-extract.ts",
    "log:reset": "tsx src/tools/log-reset.ts",
    "log:init": "tsx src/tools/log-init.ts",
    "ingest:v8": "tsx src/tools/ingest.ts --version v8",
    "extract:structure-v8": "tsx src/tools/extract-structure.ts --version v8",
    "review": "tsx src/tools/review.ts",
    "review:auto": "tsx src/tools/review.ts --auto",
    "extract:claims-v8": "tsx src/tools/extract-claims.ts --version v8 --section c2",
    "show:ricavi-v8": "tsx src/tools/show.ts --event clm-ricavi2m",
    "show": "tsx src/tools/show.ts",
    "ingest:v9": "tsx src/tools/ingest.ts --version v9",
    "extract:v9": "tsx src/tools/extract-version.ts --version v9 --section c2,c3,c5",
    "compare": "tsx src/tools/compare.ts",
    "layers-4-6": "tsx src/tools/layers-4-6.ts",
    "log:cat": "tsx src/tools/log-cat.ts",
    "projections:drop": "tsx src/tools/projections.ts drop",
    "projections:build": "tsx src/tools/projections.ts build",
    "replay:claims-v2": "tsx src/tools/replay.ts --extractor claims@v2",
    "projections:diff": "tsx src/tools/projections.ts diff --candidate claims@v2",
    "beliefs:at-2019-04-30": "tsx src/tools/beliefs.ts --at 2019-04-30",
    "beliefs": "tsx src/tools/beliefs.ts",
    "golden:claims-until-seg2": "tsx src/tools/golden.ts --layer claims --until g1",
    "golden:claims": "tsx src/tools/golden.ts --layer claims",
    "eval:claims-v1": "tsx src/tools/eval.ts --extractor claims@v1 --golden g1",
    "eval:claims-v2-summary": "tsx src/tools/eval.ts --extractor claims@v2 --golden g1 --summary",
    "drift:v1-v2": "tsx src/tools/drift.ts --from claims@v1 --to claims@v2 --golden g1",
    "ask:ricavi-2019-04-30": "tsx src/tools/not-implemented.ts ask:ricavi-2019-04-30 E2",
    "ask:ricavi": "tsx src/tools/not-implemented.ts ask:ricavi E2",
    "tail": "tsx src/tools/tail.ts",
    "viewer": "tsx src/tools/viewer.ts",
    "seg:1": "tsx src/tools/segment.ts 1",
    "seg:2": "tsx src/tools/segment.ts 2",
    "seg:3": "tsx src/tools/segment.ts 3",
    "seg:4": "tsx src/tools/segment.ts 4",
    "seg:5": "tsx src/tools/segment.ts 5",
    "seg:6": "tsx src/tools/segment.ts 6",
    "dry-run": "tsx src/tools/not-implemented.ts dry-run F2",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
