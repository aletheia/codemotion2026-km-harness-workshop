# Copy to .env (never versioned: .env is in .git/info/exclude) and fill in.
# Read only by `npm run viewer` for the Explain panel; the walkthrough scripts never use it and stay offline.
# Looked up in order: the environment, --env <file>, ./.env, then the .env of the checkout that holds the log.

# Anthropic API key; the Explain panel asks claude-haiku-5-5 to tell the story of a log row.
ANTHROPIC_API_KEY=

# Optional: another Messages API endpoint (a proxy, or a local stand-in for tests).
# ANTHROPIC_BASE_URL=https://api.anthropic.com
