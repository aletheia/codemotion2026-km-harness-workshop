{
  "permissions": {
    "allow": [
      "Bash(npm run doctor)",
      "Bash(npm run seg*)",
      "Bash(npm run unit*)",
      "Bash(npm run propose*)",
      "Bash(npm run compare*)",
      "Bash(npm run replay*)",
      "Bash(npm run tail*)",
      "Bash(npm test*)",
      "Bash(npm run test*)"
    ],
    "deny": [
      "Edit(/events/**)",
      "Edit(/.claude/skills/**)",
      "Edit(/.claude/agents/**)",
      "Edit(/.cursor/skills/**)",
      "Edit(/.cursor/agents/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/node_modules/.bin/tsx\" \"${CLAUDE_PROJECT_DIR}/tools/hooks/guard-events.ts\""
          }
        ]
      }
    ]
  }
}
